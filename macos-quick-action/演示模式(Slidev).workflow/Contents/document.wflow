        <key>ActionBundlePath</key>
        <string>/System/Library/Automator/Run Shell Script.action</string>
        <key>ActionName</key>
        <string>Run Shell Script</string>
        <key>ActionParameters</key>
        <dict>
          <key>COMMAND_STRING</key>
          <string>inputs=()

if [[ "$#" -gt 0 ]]; then
  inputs=("$@")
else
  while IFS= read -r line; do
    [[ -n "$line" ]] &amp;&amp; inputs+=("$line")
  done
fi

for f in "${inputs[@]}"; do
  case "$f" in
    *.md|*.MD|*.markdown|*.MARKDOWN)
      mkdir -p "${TMPDIR:-/tmp}/slidev-present"
      nohup "$HOME/Library/Application Support/Slidev/bin/slidev-present" "$f" &gt;&gt;"${TMPDIR:-/tmp}/slidev-present/service.log" 2&gt;&amp;1 &lt;/dev/null &amp;
      disown
      exit 0
      ;;
  esac
done

/usr/bin/osascript -e 'display notification "请选择一个 .md 幻灯片文件" with title "Slidev"'
exit 1
</string>
          <key>CheckedForUserDefaultShell</key>
